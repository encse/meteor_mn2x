    rotation: 0
    state: enabled
- name: virtual_source_0
  id: virtual_source
  parameters:
    alias: ''
    comment: "# \n\nWe delay one branch by half a symbol to convert the OQPSK stream\
      \ into a QPSK-like symbol stream before symbol synchronization.\n\nAt this stage\
      \ we do not necessarily know whether the delayed branch is the correct one.\
      \ The output may therefore contain correctly paired symbols, such as:\n\n  I0\
      \ Q0, I1 Q1, I2 Q2, ...\n\nor symbols shifted by one symbol on one branch, such\
      \ as:\n\n  I1 Q0, I2 Q1, I3 Q2, ...\n\nThis is acceptable for symbol synchronization,\
      \ because the I and Q decision points are now aligned in time. The remaining\
      \ ambiguity must be resolved later in the decoder, when searching for the sync\
      \ word."
    stream_id: costas
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [32, 588.0]
    rotation: 0
    state: enabled
- name: virtual_source_0_0
  id: virtual_source
  parameters:
    alias: ''
    comment: ''
    stream_id: symbol_synced
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [32, 1004.0]
    rotation: 0
    state: enabled
- name: virtual_source_0_1
  id: virtual_source
  parameters:
    alias: ''
    comment: ''
    stream_id: fir
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 404.0]
    rotation: 0
    state: enabled
- name: virtual_source_0_2
